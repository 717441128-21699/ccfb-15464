{
  "name": "sand-painting-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WebGPU 沙画手法训练平板应用：灯箱透射、休止角雪崩、手势识别、老师示范",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",

    "test:watch": "vitest",
    "check:wgsl": "node --experimental-strip-types scripts/check-wgsl.ts"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.51",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
